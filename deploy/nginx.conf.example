# Frontend: build with `npm run build` and copy `dist/` to /srv/webonix/dist.
# API: run CodeIgniter from backend2 with PHP-FPM on 127.0.0.1:9000.
limit_req_zone $binary_remote_addr zone=webonix_login:10m rate=5r/m;

server {
    listen 80;
    server_name nfc.webonix.com.tr;
    return 301 https://nfc.webonix.com.tr$request_uri;
}

server {
    listen 443 ssl;
    server_name nfc.webonix.com.tr;
    ssl_certificate /etc/letsencrypt/live/nfc.webonix.com.tr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nfc.webonix.com.tr/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    root /srv/webonix/dist;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://nfc-api.webonix.com.tr; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    location / { try_files $uri $uri/ /index.html; }
    location ~ /\. { deny all; }
}

server {
    listen 80;
    server_name nfc-api.webonix.com.tr;
    return 301 https://nfc-api.webonix.com.tr$request_uri;
}

server {
    listen 443 ssl;
    server_name nfc-api.webonix.com.tr;
    ssl_certificate /etc/letsencrypt/live/nfc-api.webonix.com.tr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nfc-api.webonix.com.tr/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 16k;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    location = /api/auth/login {
        limit_req zone=webonix_login burst=5 nodelay;
        limit_req_status 429;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /srv/webonix/backend2/public/index.php;
        fastcgi_param DOCUMENT_ROOT /srv/webonix/backend2/public;
        fastcgi_pass 127.0.0.1:9000;
    }

    location / {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /srv/webonix/backend2/public/index.php;
        fastcgi_param DOCUMENT_ROOT /srv/webonix/backend2/public;
        fastcgi_pass 127.0.0.1:9000;
    }
}
