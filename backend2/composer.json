{
  "name": "webonix/tap-backend",
  "description": "CodeIgniter 4 replacement for the Java API",
  "type": "project",
  "require": {
    "php": "^8.2",
    "codeigniter4/framework": "^4.6"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "mikey179/vfsstream": "^1.6",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "serve": "php spark serve --host 127.0.0.1 --port 8081",
    "test": "php tests/integration.php"
  }
}
